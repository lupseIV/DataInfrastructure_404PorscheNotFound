# Copy to .env.local for local development. Never commit .env / .env.local.
# On deploy, the GitHub workflow sets VITE_API_BASE_URL from the AWS stack automatically.
# To change the URL without rebuilding, edit public/config.json instead (it wins over these).

# Base URL of the query API, including the stage, without a trailing slash.
# Example: https://abc123.execute-api.eu-central-1.amazonaws.com/prod
VITE_API_BASE_URL=

# Optional. true = always use built-in sample data, false = always call the API.
# When unset, sample data is used only if no API URL is configured.
VITE_USE_MOCK_DATA=
